---
// Cabeçalho de design/Main.dc.html (as páginas internas marcam o item atual com .here, como em design/Auto.dc.html).
// "voltar": o cabeçalho enxuto de design/Sinistro.dc.html, só com o logo e "Voltar pro início".
interface Props {
  here?: 'voce' | 'empresa' | 'todos' | 'sobre';
  cotarHref?: string;
  voltar?: boolean;
}
const { here, cotarHref = '/#cotar', voltar = false } = Astro.props;
const cls = (k: string) => (here === k ? 'here' : undefined);
---
{voltar ? (
<header class="header" transition:persist="header-voltar">
<div class="wrap">
<a class="logo" href="/"><i aria-hidden="true"></i><span style="margin-left: 8px">ATC Seguros</span></a>
<a class="back" href="/">Voltar pro início</a>
</div>
</header>
) : (
<header class="header" transition:persist="header">
<div class="wrap">
<a class="logo" href="/"><i aria-hidden="true"></i><span style="margin-left: 8px">ATC Seguros</span></a>
<nav class="nav" aria-label="Principal">
<a class={cls('voce')} href="/seguros/para-voce">Para você</a>
<a class={cls('empresa')} href="/seguros/para-sua-empresa">Para sua empresa</a>
<a class={cls('todos')} href="/seguros">Todos os seguros</a>
<a class={cls('sobre')} href="/quem-somos">Quem somos</a>
<a class="sos" href="/sinistro">Sinistro 24h</a>
</nav>
<a class="pill pill-dark" href={cotarHref}>Quero cotar</a>
<button class="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-mobile">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
</button>
</div>
<!-- Menu mobile (opção A, tela cheia, aprovada pelo Gustavo na Etapa 5): abre/fecha em src/scripts/site.ts -->
<div class="mm" id="menu-mobile" role="dialog" aria-modal="true" aria-label="Menu" hidden>
<div class="mm-bar">
<a class="logo" href="/"><i aria-hidden="true"></i><span style="margin-left: 8px">ATC Seguros</span></a>
<button class="burger mm-close" type="button" aria-label="Fechar menu">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
</button>
</div>
<nav class="mm-nav" aria-label="Principal">
<a href="/seguros/para-voce">Para você</a>
<a href="/seguros/para-sua-empresa">Para sua empresa</a>
<a href="/seguros">Todos os seguros</a>
<a href="/quem-somos">Quem somos</a>
</nav>
<div class="mm-acts">
<a class="pill pill-yellow" href="/sinistro">Sinistro 24h</a>
<a class="pill pill-dark" href={cotarHref}>Quero cotar</a>
</div>
</div>
</header>
)}
