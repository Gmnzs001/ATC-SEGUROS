---
// Sinistro 24h: design/Sinistro.dc.html
import Layout from '../layouts/Layout.astro';
import Sinistro from '../components/Sinistro';
import { site, waLink, telLink } from '../config';
import '../styles/sinistro.css';
---
<Layout title="ATC Seguros — Sinistro 24h" interna voltar>

<div class="wrap">
<section class="top">
<div class="sun" aria-hidden="true"></div>
<div>
<h1>Aconteceu algo? Calma, a gente está aqui.</h1>
<p>Primeiro, você e quem está com você. O resto a ATC resolve com a seguradora, do começo ao fim.</p>
</div>
<div class="calls">
<a class="call call-y" href={telLink(site.telefone24h)}><span class="ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD84D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg></span><span>Ligar agora<small>24 horas: {site.telefone24h}</small></span></a>
<a class="call call-w" href={waLink()}><span class="ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.3A8.5 8.5 0 1 1 21 12z"></path></svg></span><span>Chamar no WhatsApp<small>Manda foto e localização</small></span></a>
</div>
</section>
<nav class="sos" aria-label="Emergência">
<a href="tel:192"><b>192</b>SAMU</a>
<a href="tel:193"><b>193</b>Bombeiros</a>
<a href="tel:190"><b>190</b>Polícia</a>
</nav>

<Sinistro client:load />

<section class="insurers">
<h2>Telefones 24h das seguradoras</h2>
<p class="hint">Se preferir falar direto com a sua seguradora, o número também está na sua apólice.</p>
<div class="ilist">
{site.seguradoras24h.map((s) => <div>{s.nome}<span>{s.telefone}</span></div>)}
</div>
</section>
</div>

</Layout>
