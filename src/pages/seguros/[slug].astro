---
// Página de seguro: design/Auto.dc.html é o modelo; o conteúdo vem de src/content/seguros/<slug>.md
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Simulador from '../../components/Simulador';
import Faq from '../../components/Faq';
import { site, waLink, telLink } from '../../config';
import { GROUPS, slug } from '../../data/catalogo';
import '../../styles/seguro.css';

export async function getStaticPaths() {
  const seguros = await getCollection('seguros');
  // O build quebra se faltar página pra algum item do catálogo, se sobrar arquivo fora dele
  // ou se um relacionado apontar pra página que não existe.
  const catalogo = new Set(GROUPS.flatMap((g) => g.items.map(slug)));
  const ids = new Set(seguros.map((s) => s.id));
  const faltando = [...catalogo].filter((c) => !ids.has(c));
  const sobrando = [...ids].filter((i) => !catalogo.has(i));
  const quebrados = seguros.flatMap((s) => s.data.relacionados.itens.filter((r) => !catalogo.has(r.href.replace('/seguros/', ''))).map((r) => `${s.id} → ${r.href}`));
  if (faltando.length || sobrando.length || quebrados.length) {
    throw new Error(`Catálogo e src/content/seguros não batem.
Sem página: ${faltando.join(', ') || '-'}
Fora do catálogo: ${sobrando.join(', ') || '-'}
Relacionados quebrados: ${quebrados.join(', ') || '-'}`);
  }
  return seguros.map((s) => ({ params: { slug: s.id }, props: { s: s.data } }));
}

const { s } = Astro.props;
const { abertura, cobre, naoCobre, simulador, faq, sinistro, relacionados } = s;
---
<Layout title={s.titulo} description={abertura.texto} here={s.menu} cotarHref="#simulador" interna waButton noindex={!s.revisado}>

<section class="hero">
<div class="wrap">
<nav class="crumbs" aria-label="Você está em">{abertura.migalhas.map((m) => (<Fragment><a href={m.href}>{m.nome}</a><span aria-hidden="true">/</span></Fragment>))}<span>{abertura.atual}</span></nav>
<div class="hero-grid" style="margin-top: 28px">
<div>
<h1>{abertura.titulo}</h1>
<p class="lead">{abertura.texto}</p>
<div class="btns">
<a class="pill pill-dark" href="#simulador">{abertura.botao}</a>
<a class="pill pill-white" href={waLink()}>Chamar no WhatsApp</a>
</div>
</div>
<div class="talk">
<div class="sun" aria-hidden="true"></div>
{abertura.conversa.map((m) => 'q' in m ? (
<p class="q">{m.q}</p>
) : m.fatores ? (
<div class="a"><b class="who">ATC</b>{m.a}
<div class="factors">{m.fatores.map((f) => <span>{f}</span>)}</div>
</div>
) : (
<p class="a"><b class="who">ATC</b>{m.a}</p>
))}
</div>
</div>
</div>
</section>

<section class="block">
<div class="wrap">
<h2 class="title">{cobre.titulo}</h2>
<p class="sub">{cobre.texto}</p>
<div class="covgrid">
<div class="panel panel-w">
<h3>{cobre.basico.titulo}</h3>
<p class="hint">{cobre.basico.texto}</p>
<ul class="items">
{cobre.basico.itens.map((i) => (
<li><span class="ck" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg></span><div><b>{i.nome}</b><span class="d">{i.desc}</span></div></li>
))}
</ul>
</div>
{cobre.incluir && (
<div class="panel panel-y">
<div class="circle" aria-hidden="true"></div>
<h3>{cobre.incluir.titulo}</h3>
<p class="hint">{cobre.incluir.texto}</p>
<ul class="items">
{cobre.incluir.itens.map((i) => (
<li><span class="ck" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="3" stroke-linecap="round"><path d="M12 6v12M6 12h12"></path></svg></span><div><b>{i.nome}</b><span class="d">{i.desc}</span></div></li>
))}
</ul>
</div>
)}
</div>
<div class="nope">
<div>
<h3>{naoCobre.titulo}</h3>
<p class="hint">{naoCobre.texto}</p>
</div>
<ul class="nolist">
{naoCobre.itens.map((i) => <li><b>{i.nome}</b>{i.desc}</li>)}
</ul>
</div>
</div>
</section>

<section class="simwrap" id="simulador">
<div class="wrap">
<Simulador client:visible start={simulador.inicio} title={simulador.titulo} intro={simulador.texto} />
</div>
</section>

<section class="block">
<div class="wrap">
<h2 class="title">{faq.titulo}</h2>
<Faq client:visible perguntas={faq.perguntas} />
</div>
</section>

{sinistro && (
<section class="block">
<div class="wrap">
<div class="crash">
<div class="c" aria-hidden="true"></div>
<div>
<h2>{sinistro.titulo}</h2>
<p class="lead">{sinistro.texto}</p>
<div class="btns">
<a class="pill pill-dark" href={telLink(site.telefone24h)}>Ligar 24h: {site.telefone24h}</a>
<a class="pill pill-white" href={waLink()}>Chamar no WhatsApp</a>
</div>
</div>
<ol class="todo">
{sinistro.passos.map((p, n) => (
<li><span class="n">{n + 1}</span><div><b>{p.nome}</b><span class="t">{p.desc}</span></div></li>
))}
</ol>
</div>
</div>
</section>
)}

<section class="block">
<div class="wrap">
<h2 class="title" style="font-size: 36px">{relacionados.titulo}</h2>
<div class="related">
{relacionados.itens.map((r) => <a href={r.href}>{r.nome}</a>)}
</div>
</div>
</section>

</Layout>
