---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { waLink } from '../config';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  here?: 'voce' | 'empresa' | 'sobre';
  cotarHref?: string;
  compactFooter?: boolean;
}
const { title, here, cotarHref, compactFooter = false } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<slot name="head" />
<ClientRouter />
</head>
<body>
<div class="atc" style="width: 100%; min-height: 100vh">
<Header here={here} cotarHref={cotarHref} />
<slot />
<Footer compact={compactFooter} />
<a class="wa" href={waLink()} aria-label="Falar no WhatsApp" transition:persist="wa">
<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.3A8.5 8.5 0 1 1 21 12z"></path></svg>
</a>
</div>
<script>
import '../scripts/site';
</script>
</body>
</html>
