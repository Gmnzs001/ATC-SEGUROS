---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { waLink } from '../config';
import baseCss from '../styles/base.css?url';

interface Props {
  title: string;
  // texto da busca do Google e do compartilhamento (frase que já existe no design da página)
  description: string;
  here?: 'voce' | 'empresa' | 'todos' | 'sobre';
  cotarHref?: string;
  // cabeçalho enxuto com "Voltar pro início" (design/Sinistro.dc.html)
  voltar?: boolean;
  // páginas internas: CSS de inner.css e rodapé compacto (como em design/Auto.dc.html)
  interna?: boolean;
  // botão flutuante do WhatsApp: está no design da Home e do Auto, não no de Todos/Sobre/Sinistro
  waButton?: boolean;
  // rascunho ainda não revisado pela ATC: fora do Google até a revisão
  noindex?: boolean;
}
const { title, description, here, cotarHref, voltar = false, interna = false, waButton = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href={baseCss}>
<title>{title}</title>
<Seo title={title} description={description} />
{noindex && <meta name="robots" content="noindex">}
<slot name="head" />
<ClientRouter />
</head>
<body>
<div class:list={['atc', { interna }]} style="width: 100%; min-height: 100vh">
<Header here={here} cotarHref={cotarHref} voltar={voltar} />
<slot />
<Footer compact={interna} />
{waButton && (
<a class="wa" href={waLink()} aria-label="Falar no WhatsApp" transition:persist="wa">
<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.3A8.5 8.5 0 1 1 21 12z"></path></svg>
</a>
)}
</div>
<script>
import '../scripts/site';
</script>
</body>
</html>
